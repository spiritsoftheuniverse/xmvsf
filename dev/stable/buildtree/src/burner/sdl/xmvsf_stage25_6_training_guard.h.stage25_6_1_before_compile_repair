#ifndef XMVSF_STAGE25_6_TRAINING_GUARD_H
#define XMVSF_STAGE25_6_TRAINING_GUARD_H
// Isolate a controller-owner handoff from a held character-select button.
// The owner is an existing Stage14 value; do not invent character-selected
// memory flags. Stage17's selection detector remains authoritative.
#include <SDL.h>
struct XM256TrainingGuard {
    int lastTarget=-1;
    bool waiting=false;
    Uint32 neutralSince=0;
    Uint32 lastProbeAt=0;
    bool probed=false;
};
static inline bool xm256TrainingOwnerBlock(bool training,int inputTarget){
    static XM256TrainingGuard guard;
    if(!training){guard=XM256TrainingGuard{};return false;}
    if(guard.lastTarget!=inputTarget){
        guard.lastTarget=inputTarget;
        guard.waiting=true;
        guard.neutralSince=0;
        guard.probed=false;
    }
    if(!guard.waiting)return false;
    const Uint32 now=SDL_GetTicks();
    if(guard.probed && (Uint32)(now-guard.lastProbeAt)<8)return true;
    guard.probed=true;
    guard.lastProbeAt=now;
    if(xm25HandoffAnyInputHeld())guard.neutralSince=0;
    else if(!guard.neutralSince)guard.neutralSince=now?now:1;
    else if((Uint32)(now-guard.neutralSince)>=80){
        guard.waiting=false;return false;
    }
    return true;
}
static inline void xm256NormalizeBootFaceButtons(const SDL_Event& ev,bool& accept,bool& back){
    // This changes menu behavior only, not fight controls or stored mappings.
    if(ev.type==SDL_CONTROLLERBUTTONDOWN){
        accept=ev.cbutton.button==SDL_CONTROLLER_BUTTON_A;
        back=ev.cbutton.button==SDL_CONTROLLER_BUTTON_B;
    } else if(ev.type==SDL_JOYBUTTONDOWN){
        // SDL's XInput joystick layout puts A/B on physical buttons 0/1.
        accept=ev.jbutton.button==0;
        back=ev.jbutton.button==1;
    }
}
#endif
