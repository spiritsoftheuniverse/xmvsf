#ifndef XMVSF_STAGE25_SETS_H
#define XMVSF_STAGE25_SETS_H
// XMVSF-only Versus set management. Never written into the CPS-2 save state.
#include <SDL.h>
#include "xmvsf_stage25_1_font.h" /* XMVSF_STAGE25_1_POLISH */
#include "xmvsf_native_host.h" /* XMVSF_STAGE25_2_LEDGER_RESULTS */
#include <cstdio>
#include <cstring>
#include <cctype>
